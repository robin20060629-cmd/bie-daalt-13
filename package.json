{
  "name": "markdown-notes-api",
  "version": "1.0.0",
  "description": "Markdown Note-taking REST API",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "jest --runInBand --forceExit",
    "test:coverage": "jest --coverage --forceExit",
    "db:reset": "node -e \"const fs=require('fs');fs.rmSync('./notes.db',{force:true});console.log('DB reset');\""
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "cors": "^2.8.6",
    "express": "^4.22.2",
    "marked": "^12.0.2",
    "morgan": "^1.10.1",
    "pdfmake": "^0.2.23",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
